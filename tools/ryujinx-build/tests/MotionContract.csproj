<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RyujinxRuntime Condition="'$(RyujinxRuntime)' == ''">osx-arm64</RyujinxRuntime>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(RyujinxSource)/src/Ryujinx/bin/Release/net9.0/$(RyujinxRuntime)/Ryujinx*.dll;$(RyujinxSource)/src/Ryujinx/bin/Release/net9.0/$(RyujinxRuntime)/Avalonia*.dll;$(RyujinxSource)/src/Ryujinx/bin/Release/net9.0/$(RyujinxRuntime)/CommunityToolkit*.dll" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
