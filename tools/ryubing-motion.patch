+        private static GamepadStateSnapshot DecodeControllerState(byte[] data)
+        {
+            GamepadStateSnapshot state = new();
+            // Offsets refer to the standard DSU payload, after the 16-byte header.
+            if (data[5] != 2 || data[15] == 0) return state;
+            GamepadButtonInputId[] extra = { GamepadButtonInputId.Minus, GamepadButtonInputId.LeftStick,
+                GamepadButtonInputId.RightStick, GamepadButtonInputId.Plus, GamepadButtonInputId.DpadUp,
+                GamepadButtonInputId.DpadRight, GamepadButtonInputId.DpadDown, GamepadButtonInputId.DpadLeft };
+            GamepadButtonInputId[] main = { GamepadButtonInputId.LeftTrigger, GamepadButtonInputId.RightTrigger,
+                GamepadButtonInputId.LeftShoulder, GamepadButtonInputId.RightShoulder, GamepadButtonInputId.X,
+                GamepadButtonInputId.A, GamepadButtonInputId.B, GamepadButtonInputId.Y };
+            for (int i = 0; i < 8; i++)
+            {
+                state.SetPressed(extra[i], (data[20] & (1 << i)) != 0);
+                state.SetPressed(main[i], (data[21] & (1 << i)) != 0);
+            }
+            state.SetPressed(GamepadButtonInputId.Guide, data[22] != 0);
+            state.SetPressed(GamepadButtonInputId.Misc1, data[23] != 0);
+            static float Axis(byte value) => Math.Clamp((value - 128) / 127f, -1f, 1f);
+            state.SetStick(StickInputId.Left, Axis(data[24]), Axis(data[25]));
+            state.SetStick(StickInputId.Right, Axis(data[26]), Axis(data[27]));
