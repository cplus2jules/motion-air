+                state.SetPressed(GamepadButtonInputId.SingleLeftTrigger1, (data[87] & 1) != 0);
+                state.SetPressed(GamepadButtonInputId.SingleRightTrigger0, (data[87] & 2) != 0);
+                state.SetPressed(GamepadButtonInputId.SingleRightTrigger1, (data[87] & 2) != 0);
+            }
+            return state;
